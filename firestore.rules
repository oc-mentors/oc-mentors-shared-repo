rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile (users/{uid}) and conversations + messages (users/{uid}/conversations/...)
    // Only the signed-in user can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tutors catalog: anyone can read (so users can browse); only backend/admin can write
    match /tutors/{tutorId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
