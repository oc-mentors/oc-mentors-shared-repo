rules_version = '2';

// Firebase Storage: allow authenticated users to upload/read their own avatars
// Deploy: Firebase Console → Storage → Rules, or: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
