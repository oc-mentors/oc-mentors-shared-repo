rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identity: users can read/write only their own ----
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- Role-specific profiles ----
    match /studentProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /tutorProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /tutorVerifications/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- Requests: students create; tutors read incoming; participants update status ----
    match /tutorRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.studentUid == request.auth.uid || resource.data.tutorUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.studentUid == request.auth.uid || resource.data.tutorUid == request.auth.uid);
    }

    // ---- Connections: only participants can read; writes controlled by app (participants) ----
    match /connections/{connectionId} {
      allow read: if request.auth != null
        && (resource.data.studentUid == request.auth.uid || resource.data.tutorUid == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (resource.data.studentUid == request.auth.uid || resource.data.tutorUid == request.auth.uid);
    }

    // ---- Shared conversations: only participants can read/write ----
    match /conversations/{conversationId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantUids;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
      }
    }

    // ---- Reviews: participants and public read; create by participants ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.studentUid == request.auth.uid;
    }

    // ---- Sessions (future-ready): participants only ----
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // ---- Legacy: tutors catalog (read-only for clients; backend writes) ----
    match /tutors/{tutorId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
