# Firebase – copy to .env.local and fill with values from Firebase Console
# Get these from: Project settings → Your apps → Web app config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Study Hub Socratic tutor — pick one or both:
# (A) Local dev (fastest): key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# (B) Production: firebase functions:secrets:set GEMINI_API_KEY && firebase deploy --only functions:socraticStudyChat
